# ==================== 通用配置 ====================
# 环境标识：dev / prod
APP_ENV=dev

# 当前激活模型（可选：deepseek / qwen / kimi / claude）
ACTIVE_MODEL=deepseek

# 思考模式
ENABLE_THINKING=false
REASONING_EFFORT=high
THINKING_BUDGET_TOKENS=4096

# 请求参数
MAX_TOKENS=4096
TEMPERATURE=0.7
TIMEOUT=120
MAX_RETRIES=3

# 上下文管理
MAX_CONTEXT_TOKENS=8000
MAX_HISTORY_ROUNDS=10

# 应用
DEBUG=false
LOG_LEVEL=INFO

# ==================== 模型配置 ====================
# 每个模型需要配置：{PREFIX}_API_KEY / {PREFIX}_BASE_URL / {PREFIX}_MODEL / {PREFIX}_PROVIDER

# --- DeepSeek（OpenAI 格式）---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PROVIDER=openai

# --- 通义千问 Qwen（OpenAI 格式 / DashScope 兼容）---
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_PROVIDER=openai

# --- Kimi / Moonshot（OpenAI 格式）---
KIMI_API_KEY=sk-your-kimi-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_PROVIDER=openai

# --- Claude（Anthropic 格式）---
CLAUDE_API_KEY=sk-ant-your-claude-key
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_PROVIDER=anthropic
